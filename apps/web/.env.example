# ── Database ────────────────────────────────────────────────────────────────
# Unset → embedded PGlite in .data/pglite (zero-setup local dev, auto-seeded).
# DATABASE_URL=postgres://user:pass@host/db

# ── AI layer (D19) — optional; absent = AI surfaces show "not configured" ───
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5

# ── Slack (D18) — optional; see docs/SLACK_SETUP.md ─────────────────────────
# SLACK_SIGNING_SECRET=...
# DIGEST_SECRET=...
# APP_URL=https://your-host
# Env fallback for a single dev workspace (production uses slack_connections):
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C...
# SLACK_TEAM_ID=T...
# SLACK_ORG_ID=org-meridian
