# OrgMarket configuration. Copy to apps/web/.env.local for local dev, or to a
# .env next to docker-compose.yml for self-hosting. Everything is optional for
# a local demo: with no DATABASE_URL and no SSO, you get an embedded database,
# a seeded demo org, and the demo sign-in picker.

# ── Database ────────────────────────────────────────────────────────────────
# Unset → embedded PGlite in .data/pglite (zero setup, auto-seeded demo).
# DATABASE_URL=postgres://user:pass@host:5432/orgmarket
# SEED_DEMO=1                  # seed the demo org into an empty Postgres

# ── Sign-in (D20) ───────────────────────────────────────────────────────────
# AUTH_SECRET=                 # required with SSO: `openssl rand -base64 32`
# AUTH_TRUST_HOST=true         # when running behind a reverse proxy
# Any provider whose vars are set appears on the login page. New users are
# auto-provisioned when their email domain is in the org's allowedDomains.
# AUTH_GOOGLE_ID=  AUTH_GOOGLE_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=  AUTH_MICROSOFT_ENTRA_ID_SECRET=  AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# AUTH_OKTA_ID=  AUTH_OKTA_SECRET=  AUTH_OKTA_ISSUER=
# AUTH_GITHUB_ID=  AUTH_GITHUB_SECRET=
# Generic OIDC — also how SAML IdPs connect, via an OIDC bridge such as
# BoxyHQ SAML Jackson:
# AUTH_OIDC_ISSUER=  AUTH_OIDC_ID=  AUTH_OIDC_SECRET=  AUTH_OIDC_NAME="Company SSO"
# DEV_LOGIN=1                  # demo picker; default on only in dev without SSO

# ── Scheduler (D20) ─────────────────────────────────────────────────────────
# CRON_SECRET=                 # POST /api/cron/tick with "Authorization: Bearer $CRON_SECRET"

# ── AI layer (D19) — absent = AI surfaces show "not configured" ─────────────
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5

# ── Slack (D18) — see docs/SLACK_SETUP.md ───────────────────────────────────
# SLACK_SIGNING_SECRET=
# DIGEST_SECRET=
# APP_URL=https://orgmarket.example.com
# SLACK_BOT_TOKEN=xoxb-...   SLACK_CHANNEL_ID=C...   SLACK_TEAM_ID=T...   SLACK_ORG_ID=org-meridian
